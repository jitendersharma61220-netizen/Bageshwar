# ---------------------------------------------------------------------------
# Bageshwar Balaji Construction Co. — environment variables
# Copy to .env.local for development. NEVER commit a filled-in .env file.
# ---------------------------------------------------------------------------

# Public site origin, used for canonical URLs, sitemap and Open Graph.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.bageshwarbalaji.com

# ---------------------------------------------------------------------------
# Lead capture
#
# LEAD_SINK selects the SYSTEM OF RECORD — where the enquiry is durably kept.
#   console   logs the enquiry to the server console (local development)
#   supabase  inserts into website_leads (production)
#
# Email notification is separate and is added automatically whenever
# RESEND_API_KEY, LEAD_EMAIL_FROM and LEAD_EMAIL_TO are all set. A failed
# notification never fails the request: the lead is already recorded.
# ---------------------------------------------------------------------------
LEAD_SINK=console

# ---------------------------------------------------------------------------
# Document storage for BOQ / tender uploads
#   filesystem  writes under UPLOAD_DIR (local development; gitignored)
#   supabase    uploads to the private lead-documents bucket (production)
# ---------------------------------------------------------------------------
DOCUMENT_STORE=filesystem
UPLOAD_DIR=./uploads

# Resend API key. Server-only — must never be exposed to the browser.
RESEND_API_KEY=
# Verified sender on your Resend domain.
LEAD_EMAIL_FROM=website@bageshwarbalaji.com
# Comma-separated internal recipients for new enquiries.
LEAD_EMAIL_TO=

# ---------------------------------------------------------------------------
# Analytics (optional — the site renders correctly with these unset)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Google Search Console HTML meta verification token (the content= value only).
NEXT_PUBLIC_GSC_VERIFICATION=

# ---------------------------------------------------------------------------
# Supabase
#
# Required when LEAD_SINK=supabase or DOCUMENT_STORE=supabase. Apply the SQL in
# supabase/migrations first (see supabase/README.md).
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security and is SERVER-ONLY.
# lib/supabase/client.ts is marked `server-only`, so importing it from a client
# component is a build error rather than a leak.
#
# The anon key is safe to expose: no RLS policy grants it read or write on any
# table, and the document bucket is private.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI provider — NOT used in Iteration 1. Reserved for Iteration 5 onward.
# The AI layer is provider-agnostic; AI_PROVIDER selects the implementation.
# ---------------------------------------------------------------------------
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# OPENAI_API_KEY=
